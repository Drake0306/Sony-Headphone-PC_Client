{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SHDC",
  "version": "0.5.1",
  "identifier": "com.drake0306.hairline",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "shortDescription": "Menu-bar control for Sony ULT WEAR headphones",
    "publisher": "Abhinav Roy",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Drake0306/Sony-Headphone-PC_Client/releases/latest/download/latest.json",
        "https://raw.githubusercontent.com/Drake0306/Sony-Headphone-PC_Client/updates/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFCMDk2QTVGMzJDQ0VENkUKUldSdTdjd3lYMm9KR3dQY3ZFUWVUelpkZDdpQ3FwRk44MHFjcDMvd25ZMkZMcmVuK2N4SVZNbUQK"
    }
  }
}
